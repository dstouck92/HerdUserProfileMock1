# Supabase — get these from your project: Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Setlist.fm (optional — key is hardcoded fallback for local dev)
SETLIST_FM_API_KEY=your-setlist-fm-api-key

# Discogs (optional — vinyl search uses User-Agent only; store these if you add OAuth later)
# DISCOGS_CONSUMER_KEY=your-consumer-key
# DISCOGS_CONSUMER_SECRET=your-consumer-secret

# Ticketmaster Discovery API (for Marketplace concerts; server-side only)
# Get an API key from the Ticketmaster developer portal and paste it here.
# This key is read ONLY on the server (never exposed to the client).
TICKETMASTER_API_KEY=your-ticketmaster-api-key

# Spotify (required for Search page artist search and herd artist images)
# Get from developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=ab91f77609044a70b58a0ca35d1692d9
SPOTIFY_CLIENT_SECRET=571db13df27d4b079220d7f68af95a73

# YouTube (required for Connect YouTube on Digital tab)
YOUTUBE_CLIENT_ID=your-youtube-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
# Redirect URI: in dev use http://localhost:5173/api/auth/youtube/callback (or your production URL in prod)
YOUTUBE_REDIRECT_URI=http://localhost:5173/api/auth/youtube/callback

# Supabase service role (server only — for storing YouTube tokens; never expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

